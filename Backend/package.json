{
  "name": "jazari-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Jazari Tech Official — Express/Mongoose API server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "dev:mem": "node scripts/dev-memory.js",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "seed:mem": "node scripts/dev-memory.js --seed",
    "seed:mem:once": "node scripts/dev-memory.js --seed-only",
    "smoke": "node scripts/smoke.js",
    "lint": "eslint .",
    "build": "node scripts/syntax-check.js"
  },
  "keywords": [
    "jazari",
    "api",
    "express",
    "mongoose"
  ],
  "author": "Jazari Tech Official",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.6.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0"
  }
