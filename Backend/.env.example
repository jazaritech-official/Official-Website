# Backend environment template — copy to `Backend/.env` and fill in real values.
# `Backend/.env` is gitignored. NEVER commit real secrets here.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# MongoDB connection string for your deployment.
# Use angle-bracket placeholders ONLY — never paste a real cluster URI here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>

# JWT signing secret — at least 32 random characters in production.
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# Cloudinary (required in production; optional in development).
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Seed / Super Admin account.
# The account below is promoted to `super_admin` on seed. Its existing password
# is PRESERVED unless SEED_RESET_ADMIN_PASSWORD=true.
ADMIN_EMAIL=<super-admin-email>
ADMIN_PASSWORD=<strong-password>
# Optional display name for the seeded Super Admin.
ADMIN_NAME=<display-name>
# Set to true only when you intentionally want the seed to overwrite the
# configured account's password.
SEED_RESET_ADMIN_PASSWORD=false
# Legacy/demo account to deactivate on seed (unless it IS the configured account).
DEMO_ADMIN_EMAIL=<legacy-admin-email>

# Rate limits.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
SUBMISSION_RATE_LIMIT_MAX=5
VISITOR_RATE_LIMIT_MAX=120
SENSITIVE_RATE_LIMIT_MAX=30

VISITOR_DEDUPE_HOURS=24

# --- Web Push (VAPID) ---
# Generate a key pair with:  npx web-push generate-vapid-keys
# Both keys are required to SEND notifications. When either is missing the API
# still stores subscriptions but sending returns 503 (the site never breaks).
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
# Contact for the push service — a mailto: address or an https: URL.
VAPID_SUBJECT=mailto:hello@jazaritech.com
PUSH_RATE_LIMIT_MAX=60
PUSH_MAX_FAILURES=5

JSON_BODY_LIMIT=15mb
