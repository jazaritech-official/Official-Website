# Jazari Tech Official — backend environment example
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API (no "*").
CLIENT_ORIGIN=http://localhost:3000

# Reverse-proxy hops to trust for client IP extraction (number | true | false).
TRUST_PROXY=1

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/jazari-tech

# --- Authentication -------------------------------------------------------
# Use a long random string (32+ chars), e.g. `openssl rand -hex 48`.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=jazari_admin
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Cloudinary (product/logo uploads) -----------------------------------
# When these are empty the API falls back to local disk storage (Backend/uploads)
# in development only; production refuses to start without Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public base URL of this API (used to build local asset URLs), e.g. http://localhost:5000
PUBLIC_API_URL=

# --- Seed script only (used once by `npm run seed`) ----------------------
ADMIN_EMAIL=admin@jazaritech.com
ADMIN_PASSWORD=

# --- Optional tuning ------------------------------------------------------
# JSON body limit (logos are uploaded as base64 data URIs).
JSON_BODY_LIMIT=15mb
# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
SUBMISSION_RATE_LIMIT_MAX=5
VISITOR_RATE_LIMIT_MAX=120
# Visitor deduplication window (hours). 24 = one record per IP per day.
VISITOR_DEDUPE_HOURS=24
# Request logging: dev | combined | common | short
LOG_FORMAT=dev
